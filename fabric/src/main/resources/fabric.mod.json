{
  "schemaVersion": 1,
  "id": "kirin",
  "version": "${version}",
  "name": "Kirin UI",
  "description": "Embedded common code used across several Mine Little Pony projects to create their GUIs.",
  "authors": [ "Sollace", "eternalfusion (neoforge)" ],
  "contact": {
    "homepage": "https://minelittlepony-mod.com/",
    "sources": "https://github.com/eternalfusion/Kirin",
    "issues": "https://github.com/eternalfusion/Kirin/issues"
  },
  "mixins": [
    "kirin.mixin.json"
  ],
  "entrypoints": {
    "client": [
      "com.minelittlepony.kirin.fabric.KirinFabric"
    ]
  },
  "license": "MIT",
  "icon": "kirin_logo.png",
  "accessWidener": "kirin.aw",
  "environment": "*",
  "depends": {
    "minecraft": "~26.3",
    "fabricloader": ">=${fabric_loader_version}",
    "java": ">=25"
  },
  "custom": {
    "modmenu": {
      "badges": [ "library" ],
      "links": {
        "modmenu.discord": "https://discord.gg/zKSZ8Mg"
      }
    },
    "loom:injected_interfaces": {
      "net/minecraft/client/gui/screens/Screen": ["com/minelittlepony/common/client/gui/IViewRootDefaultImpl"]
    }
  }
}
